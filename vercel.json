{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/login.html", "destination": "/public/login.html" },
    { "source": "/admin", "destination": "/public/admin/index.html" },
    { "source": "/admin/", "destination": "/public/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/public/admin/:path*" },
    { "source": "/driver", "destination": "/public/driver/index.html" },
    { "source": "/driver/", "destination": "/public/driver/index.html" },
    { "source": "/driver/:path*", "destination": "/public/driver/:path*" },
    { "source": "/shared/:path*", "destination": "/public/shared/:path*" },
    { "source": "/js/:path*", "destination": "/js/:path*" },
    { "source": "/css/:path*", "destination": "/css/:path*" },
    { "source": "/data/:path*", "destination": "/data/:path*" }
  ]
}
